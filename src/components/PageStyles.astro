---
---

<style is:global>
  .hero {
    background-image: linear-gradient(90deg, rgba(10,20,32,0.82), rgba(10,20,32,0.48) 48%, rgba(10,20,32,0.18)), url('/imagenes/fondo-1.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: background-image 0.95s ease-in-out;
    will-change: background-image;
  }

  .home-hero {
    overflow: hidden;
  }

  .hero-video-stage {
    background: transparent;
    inset: 0;
    overflow: hidden;
    position: absolute;
    z-index: 0;
  }

  .hero-video {
    height: 100%;
    inset: 0;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transform: scale(1.02);
    transition: opacity 1.65s cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
  }

  .hero-video.is-active {
    animation: hero-video-drift 5s linear forwards;
  }

  .hero-video.is-active.is-playing {
    opacity: 1;
  }

  .hero-video:nth-child(even).is-active {
    animation-name: hero-video-drift-alt;
  }

  @keyframes hero-video-drift {
    from { transform: scale(1.015) translate3d(0, 0, 0); }
    to { transform: scale(1.055) translate3d(-0.8%, -0.55%, 0); }
  }

  @keyframes hero-video-drift-alt {
    from { transform: scale(1.015) translate3d(0, 0, 0); }
    to { transform: scale(1.055) translate3d(0.8%, -0.55%, 0); }
  }

  .hero-video-stage__overlay {
    background:
      linear-gradient(90deg, rgba(10, 20, 32, 0.86), rgba(10, 20, 32, 0.5) 48%, rgba(10, 20, 32, 0.18)),
      linear-gradient(180deg, rgba(10, 20, 32, 0.18), rgba(10, 20, 32, 0.38));
    inset: 0;
    position: absolute;
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  .hero__title,
  .hero__subtitle {
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity, transform;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__cta--primary {
    border: 1px solid var(--color-white);
    padding: 0.9rem 1.2rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
  }

  .fade-in  { opacity: 1; transform: translateY(0); }
  .fade-out { opacity: 0; transform: translateY(10px); }

  .service-finder {
    background: transparent;
    border-bottom: 0;
    margin-top: 0;
    padding-block: clamp(var(--space-8), 5vw, var(--space-12));
    padding-inline: var(--space-6);
    position: relative;
    z-index: 5;
  }

  .service-finder .container {
    display: grid;
    gap: var(--space-7);
    align-items: stretch;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    box-shadow: 0 20px 60px rgba(24, 43, 73, 0.07);
    max-width: 82rem;
    padding: clamp(var(--space-7), 4vw, var(--space-10));
  }

  .service-finder__label {
    align-self: start;
    color: var(--color-indigo);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .service-finder__grid {
    display: grid;
    gap: 1px;
    background: transparent;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .service-finder__item {
    background: #fbfaf6;
    border: 1px solid var(--color-border);
    color: inherit;
    display: grid;
    gap: var(--space-4);
    min-height: 220px;
    overflow: hidden;
    padding: clamp(var(--space-6), 3vw, var(--space-8));
    position: relative;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .service-finder__item::after {
    background: rgba(179, 139, 74, 0.46);
    bottom: 0;
    content: "";
    height: 2px;
    left: clamp(var(--space-6), 3vw, var(--space-8));
    position: absolute;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.2s ease;
    width: calc(100% - (clamp(var(--space-6), 3vw, var(--space-8)) * 2));
  }

  .service-finder__item:hover {
    background: var(--color-white);
    border-color: rgba(179, 139, 74, 0.34);
    box-shadow: 0 18px 42px rgba(24, 43, 73, 0.08);
    transform: translateY(-3px);
  }

  .service-finder__item:hover::after {
    transform: scaleX(1);
  }

  .service-finder__item small {
    color: var(--color-gold);
    display: block;
    font-size: var(--text-xs);
    font-weight: 900;
    letter-spacing: 0.16em;
  }

  .service-finder__item h3 {
    color: var(--color-indigo);
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 2.4vw, var(--text-4xl));
    font-weight: 400;
    line-height: 1.06;
    margin: var(--space-6) 0 0;
    text-wrap: balance;
  }

  .service-finder__item p {
    align-self: end;
    color: var(--color-body);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  .section-kicker {
    display: block;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--color-gold);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .section-kicker--light {
    color: rgba(255,255,255,0.72);
  }

  .section-heading {
    max-width: 44rem;
    margin: 0 auto var(--space-12);
    text-align: center;
  }

  .section-heading--left {
    margin-inline: 0;
    text-align: left;
  }

  .section-heading h2,
  .section-heading h1,
  .editorial-grid h2,
  .editorial-grid h1,
  .manifesto-section h2 {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .page-first-section {
    scroll-margin-top: 96px;
  }

  .section-heading p,
  .editorial-copy p,
  .manifesto-section p {
    color: var(--color-body);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .section-axes .section-heading p {
    color: rgba(255,255,255,0.78);
  }

  .services-editorial {
    background: var(--color-cream);
    overflow: hidden;
    padding: clamp(var(--space-14), 9vw, var(--space-24)) 0;
  }

  .services-editorial__intro {
    margin: 0 auto var(--space-10);
    max-width: 72rem;
    padding-inline: var(--space-6);
  }

  .services-editorial__intro h2 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.06;
    margin: 0;
  }

  .services-editorial__rail {
    align-items: center;
    display: grid;
    gap: clamp(2rem, 4vw, 4.75rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-content: center;
    margin-inline: auto;
    max-width: 86rem;
    overflow: visible;
    padding: var(--space-8) clamp(var(--space-6), 5vw, var(--space-12)) var(--space-12);
  }

  .services-editorial__rail::-webkit-scrollbar {
    display: none;
  }

  .services-editorial__item {
    border: clamp(0.8rem, 1.4vw, 1.25rem) solid var(--color-cream);
    color: var(--color-white);
    display: block;
    isolation: isolate;
    min-height: 28rem;
    overflow: hidden;
    position: relative;
  }

  .services-editorial__item::after {
    background:
      linear-gradient(180deg, rgba(10, 20, 32, 0.1), rgba(10, 20, 32, 0.42)),
      linear-gradient(90deg, rgba(10, 20, 32, 0.46), transparent 58%);
    content: "";
    inset: 0;
    position: absolute;
    z-index: 1;
  }

  .services-editorial__item img {
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    transform: scale(1.01);
    transition: transform 0.8s ease;
    width: 100%;
  }

  .services-editorial__item:hover img {
    transform: scale(1.06);
  }

  .services-editorial__item span {
    align-items: center;
    display: flex;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.8vw, 1.9rem);
    font-style: italic;
    gap: var(--space-3);
    left: clamp(var(--space-5), 2vw, var(--space-7));
    line-height: 1.12;
    max-width: calc(100% - clamp(2.5rem, 4vw, 3.5rem));
    position: absolute;
    top: clamp(var(--space-5), 2vw, var(--space-7));
    z-index: 2;
  }

  .services-editorial__item span::before {
    background: currentColor;
    content: "";
    display: block;
    flex: 0 0 clamp(2rem, 3vw, 3rem);
    height: 1px;
    width: clamp(2rem, 3vw, 3rem);
  }

  .services-editorial__item--left,
  .services-editorial__item--right,
  .services-editorial__item--center {
    aspect-ratio: 0.92;
    margin-top: 0;
    min-height: 28rem;
  }

  .services-editorial__item--left {
    margin-top: 0;
  }

  .services-editorial__item--right {
    margin-top: 0;
  }

  .services-editorial__item--center span {
    bottom: auto;
    left: clamp(var(--space-5), 2vw, var(--space-7));
    right: clamp(var(--space-5), 2vw, var(--space-7));
    top: clamp(var(--space-5), 2vw, var(--space-7));
  }

  .services-editorial__arrow {
    border-bottom: 3px solid rgba(24, 43, 73, 0.82);
    margin: var(--space-8) clamp(var(--space-6), 8vw, var(--space-20)) 0 auto;
    max-width: 18rem;
    position: relative;
    width: 28vw;
  }

  .services-editorial__arrow::after {
    border-right: 3px solid rgba(24, 43, 73, 0.82);
    border-top: 3px solid rgba(24, 43, 73, 0.82);
    content: "";
    height: 2.1rem;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-48%) rotate(45deg);
    width: 2.1rem;
  }

  .services-hero {
    background:
      linear-gradient(120deg, rgba(10, 20, 32, 0.96), rgba(24, 43, 73, 0.78)),
      url('/imagenes/medidas/nuevas/paisaje-spain.jpg');
    background-position: center;
    background-size: cover;
    color: var(--color-white);
    overflow: hidden;
    padding: clamp(var(--space-16), 11vw, var(--space-24)) 0;
  }

  .services-hero__inner {
    display: grid;
    gap: clamp(var(--space-10), 6vw, var(--space-16));
  }

  .services-hero__copy {
    max-width: 76rem;
  }

  .services-hero__copy h1 {
    color: var(--color-white);
    font-size: clamp(3.4rem, 7vw, 7.2rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.94;
    margin: var(--space-5) 0 var(--space-6);
    text-wrap: balance;
  }

  .services-hero__copy p {
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(var(--text-lg), 1.6vw, var(--text-2xl));
    line-height: 1.62;
    max-width: 48rem;
  }

  .services-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .services-hero__proof {
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 86rem;
  }

  .services-hero__proof article {
    background: rgba(10, 20, 32, 0.48);
    display: grid;
    gap: var(--space-3);
    min-height: 13rem;
    padding: clamp(var(--space-5), 3vw, var(--space-7));
  }

  .services-hero__proof span {
    color: var(--color-gold);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .services-hero__proof strong {
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 2vw, var(--text-4xl));
    font-weight: 400;
    line-height: 1.05;
  }

  .services-hero__proof p {
    align-self: end;
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .services-operating {
    background: var(--color-sand);
    padding: clamp(var(--space-16), 9vw, var(--space-24)) 0;
  }

  .services-operating__layout {
    align-items: start;
    display: grid;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
  }

  .services-operating__intro {
    display: grid;
    gap: var(--space-5);
    max-width: 42rem;
  }

  .services-operating__intro h2 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    font-weight: 400;
    line-height: 1;
    text-wrap: balance;
  }

  .services-operating__intro p {
    color: var(--color-body);
    font-size: clamp(var(--text-base), 1.4vw, var(--text-xl));
    line-height: 1.75;
  }

  .services-operating__steps {
    border-top: 1px solid var(--color-border);
    display: grid;
  }

  .services-operating__steps article {
    align-items: start;
    border-bottom: 1px solid var(--color-border);
    display: grid;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
    grid-template-columns: 4.5rem minmax(10rem, 0.45fr) minmax(0, 1fr);
    padding: clamp(var(--space-5), 3.5vw, var(--space-7)) 0;
  }

  .services-operating__steps span,
  .services-capability span {
    color: var(--color-gold);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .services-operating__steps h3 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-2xl), 2.6vw, var(--text-4xl));
    font-weight: 400;
    line-height: 1.05;
  }

  .services-operating__steps p {
    color: var(--color-body);
    font-size: var(--text-base);
    line-height: 1.68;
  }

  .services-capabilities {
    background: #ede8dd;
    padding: clamp(var(--space-16), 10vw, var(--space-24)) 0;
  }

  .services-capabilities__grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--space-10);
  }

  .services-capability {
    background: var(--color-white);
    color: var(--color-indigo);
    display: grid;
    grid-template-rows: 17rem 1fr;
    min-height: 34rem;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .services-capability:hover {
    box-shadow: 0 28px 80px rgba(24, 43, 73, 0.14);
    transform: translateY(-4px);
  }

  .services-capability img {
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
    width: 100%;
  }

  .services-capability:hover img {
    transform: scale(1.05);
  }

  .services-capability div {
    align-content: start;
    display: grid;
    gap: var(--space-4);
    padding: clamp(var(--space-6), 3vw, var(--space-8));
  }

  .services-capability h3 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-2xl), 2.2vw, var(--text-4xl));
    font-weight: 400;
    line-height: 1.05;
  }

  .services-capability p {
    color: var(--color-body);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .services-final-cta {
    background: var(--color-indigo);
    color: var(--color-white);
    padding: clamp(var(--space-16), 9vw, var(--space-24)) 0;
  }

  .services-final-cta__inner {
    display: grid;
    gap: var(--space-6);
    max-width: 60rem;
  }

  .services-final-cta h2 {
    color: var(--color-white);
    font-size: clamp(var(--text-4xl), 5vw, 5.6rem);
    font-weight: 400;
    line-height: 1.04;
    margin: 0;
    text-wrap: balance;
  }

  .services-final-cta p {
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin: 0;
    max-width: 48rem;
  }

  .estate-section {
    background: #ede8dd;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .estate-section__content {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(var(--space-12), 8vw, var(--space-20)) var(--space-6);
  }

  .estate-section__header {
    align-items: end;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.75fr);
    gap: var(--space-12);
  }

  .estate-section__content h2 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.08;
    margin-bottom: var(--space-6);
  }

  .estate-section__content h1 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.08;
    margin-bottom: var(--space-6);
  }

  .estate-section__header p {
    color: var(--color-body);
    font-size: var(--text-lg);
    line-height: 1.7;
    max-width: 34rem;
  }

  .estate-section__note {
    align-items: center;
    background: var(--color-indigo);
    color: var(--color-white);
    display: grid;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-10, 2.5rem);
    padding: var(--space-6) var(--space-8);
  }

  .estate-section__note strong {
    color: var(--color-gold);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .estate-section__note span {
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .estate-process {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    max-width: 48rem;
  }

  .estate-process li {
    border-top: 1px solid var(--color-border);
    color: var(--color-body);
    font-size: var(--text-sm);
    line-height: 1.7;
    padding-top: var(--space-4);
  }

  .estate-process strong {
    color: var(--color-indigo);
    display: inline;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    margin-right: var(--space-2);
  }

  .restoration-section {
    background: #f7f4ee;
    padding-block: var(--space-20);
  }

  .restoration-section__header {
    margin-bottom: var(--space-8);
  }

  .restoration-section__header h2 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.08;
    max-width: 50rem;
  }

  .restoration-section__header p {
    color: var(--color-body);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-top: var(--space-4);
    max-width: 46rem;
  }

  .restoration-compare {
    position: relative;
    aspect-ratio: 16 / 9;
    min-height: 420px;
    overflow: hidden;
    background: #111827;
    border: 1px solid var(--color-border);
    box-shadow: 0 24px 70px rgba(24, 43, 73, 0.12);
    isolation: isolate;
  }

  .restoration-compare__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .restoration-compare__after {
    position: absolute;
    inset: 0;
    width: 100%;
    clip-path: inset(0 50% 0 0);
    z-index: 2;
  }

  .restoration-compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: var(--color-white);
    transform: translateX(-50%);
    z-index: 4;
  }

  .restoration-compare__handle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    background:
      linear-gradient(45deg, transparent 42%, var(--color-white) 42% 58%, transparent 58%) 12px 50% / 8px 8px no-repeat,
      linear-gradient(225deg, transparent 42%, var(--color-white) 42% 58%, transparent 58%) 26px 50% / 8px 8px no-repeat,
      rgba(24, 43, 73, 0.72);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.24);
    transform: translate(-50%, -50%);
    backdrop-filter: blur(8px);
  }

  .restoration-compare__range {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
  }

  .restoration-compare__label {
    position: absolute;
    top: var(--space-6);
    z-index: 6;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-indigo);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    padding: 0.65rem 0.85rem;
