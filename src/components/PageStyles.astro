---
---

<style is:global>
  .hero {
    background-image: linear-gradient(90deg, rgba(10,20,32,0.82), rgba(10,20,32,0.48) 48%, rgba(10,20,32,0.18)), url('/imagenes/fondo-1.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: background-image 0.95s ease-in-out;
    will-change: background-image;
  }

  .home-hero {
    overflow: hidden;
  }

  .hero-video-stage {
    background: transparent;
    inset: 0;
    overflow: hidden;
    position: absolute;
    z-index: 0;
  }

  .hero-video {
    height: 100%;
    inset: 0;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transform: scale(1.02);
    transition: opacity 1.65s cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
  }

  .hero-video.is-active {
    animation: hero-video-drift 5s linear forwards;
  }

  .hero-video.is-active.is-playing {
    opacity: 1;
  }

  .hero-video:nth-child(even).is-active {
    animation-name: hero-video-drift-alt;
  }

  @keyframes hero-video-drift {
    from { transform: scale(1.015) translate3d(0, 0, 0); }
    to { transform: scale(1.055) translate3d(-0.8%, -0.55%, 0); }
  }

  @keyframes hero-video-drift-alt {
    from { transform: scale(1.015) translate3d(0, 0, 0); }
    to { transform: scale(1.055) translate3d(0.8%, -0.55%, 0); }
  }

  .hero-video-stage__overlay {
    background:
      linear-gradient(90deg, rgba(10, 20, 32, 0.86), rgba(10, 20, 32, 0.5) 48%, rgba(10, 20, 32, 0.18)),
      linear-gradient(180deg, rgba(10, 20, 32, 0.18), rgba(10, 20, 32, 0.38));
    inset: 0;
    position: absolute;
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  .hero__title,
  .hero__subtitle {
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity, transform;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .hero__cta--primary {
    border: 1px solid var(--color-white);
    padding: 0.9rem 1.2rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
  }

  .fade-in  { opacity: 1; transform: translateY(0); }
  .fade-out { opacity: 0; transform: translateY(10px); }

  .service-finder {
    background: transparent;
    border-bottom: 0;
    margin-top: -3.5rem;
    padding-inline: var(--space-6);
    position: relative;
    z-index: 5;
  }

  .service-finder .container {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-6);
    align-items: stretch;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    box-shadow: 0 24px 70px rgba(24, 43, 73, 0.12);
    max-width: 72rem;
    padding: var(--space-5, 1.25rem);
  }

  .service-finder__label {
    align-self: start;
    color: var(--color-indigo);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .service-finder__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
  }

  .service-finder__item {
    background: var(--color-white);
    display: grid;
    gap: var(--space-2);
    min-height: 84px;
    padding: var(--space-4);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .service-finder__item:hover {
    background: #f7f4ee;
    transform: translateY(-2px);
  }

  .service-finder__item small {
    color: var(--color-gold);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .service-finder__item span {
    display: block;
    color: var(--color-indigo);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.15;
  }

  .section-kicker {
    display: block;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--color-gold);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .section-kicker--light {
    color: rgba(255,255,255,0.72);
  }

  .section-heading {
    max-width: 44rem;
    margin: 0 auto var(--space-12);
    text-align: center;
  }

  .section-heading--left {
    margin-inline: 0;
    text-align: left;
  }

  .section-heading h2,
  .section-heading h1,
  .editorial-grid h2,
  .editorial-grid h1,
  .manifesto-section h2 {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .page-first-section {
    scroll-margin-top: 96px;
  }

  .section-heading p,
  .editorial-copy p,
  .manifesto-section p {
    color: var(--color-body);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .section-axes .section-heading p {
    color: rgba(255,255,255,0.78);
  }

  .services-editorial {
    background: var(--color-cream);
    overflow: hidden;
    padding: clamp(var(--space-14), 9vw, var(--space-24)) 0;
  }

  .services-editorial__intro {
    margin: 0 auto var(--space-10);
    max-width: 72rem;
    padding-inline: var(--space-6);
  }

  .services-editorial__intro h2 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.06;
    margin: 0;
  }

  .services-editorial__rail {
    align-items: center;
    display: grid;
    gap: clamp(2rem, 4vw, 4.75rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-content: center;
    margin-inline: auto;
    max-width: 86rem;
    overflow: visible;
    padding: var(--space-8) clamp(var(--space-6), 5vw, var(--space-12)) var(--space-12);
  }

  .services-editorial__rail::-webkit-scrollbar {
    display: none;
  }

  .services-editorial__item {
    border: clamp(0.8rem, 1.4vw, 1.25rem) solid var(--color-cream);
    color: var(--color-white);
    display: block;
    isolation: isolate;
    min-height: 28rem;
    overflow: hidden;
    position: relative;
  }

  .services-editorial__item::after {
    background:
      linear-gradient(180deg, rgba(10, 20, 32, 0.1), rgba(10, 20, 32, 0.42)),
      linear-gradient(90deg, rgba(10, 20, 32, 0.46), transparent 58%);
    content: "";
    inset: 0;
    position: absolute;
    z-index: 1;
  }

  .services-editorial__item img {
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    transform: scale(1.01);
    transition: transform 0.8s ease;
    width: 100%;
  }

  .services-editorial__item:hover img {
    transform: scale(1.06);
  }

  .services-editorial__item span {
    align-items: center;
    display: flex;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.8vw, 1.9rem);
    font-style: italic;
    gap: var(--space-3);
    left: clamp(var(--space-5), 2vw, var(--space-7));
    line-height: 1.12;
    max-width: calc(100% - clamp(2.5rem, 4vw, 3.5rem));
    position: absolute;
    top: clamp(var(--space-5), 2vw, var(--space-7));
    z-index: 2;
  }

  .services-editorial__item span::before {
    background: currentColor;
    content: "";
    display: block;
    flex: 0 0 clamp(2rem, 3vw, 3rem);
    height: 1px;
    width: clamp(2rem, 3vw, 3rem);
  }

  .services-editorial__item--left,
  .services-editorial__item--right,
  .services-editorial__item--center {
    aspect-ratio: 0.92;
    margin-top: 0;
    min-height: 28rem;
  }

  .services-editorial__item--left {
    margin-top: 0;
  }

  .services-editorial__item--right {
    margin-top: 0;
  }

  .services-editorial__item--center span {
    bottom: auto;
    left: clamp(var(--space-5), 2vw, var(--space-7));
    right: clamp(var(--space-5), 2vw, var(--space-7));
    top: clamp(var(--space-5), 2vw, var(--space-7));
  }

  .services-editorial__arrow {
    border-bottom: 3px solid rgba(24, 43, 73, 0.82);
    margin: var(--space-8) clamp(var(--space-6), 8vw, var(--space-20)) 0 auto;
    max-width: 18rem;
    position: relative;
    width: 28vw;
  }

  .services-editorial__arrow::after {
    border-right: 3px solid rgba(24, 43, 73, 0.82);
    border-top: 3px solid rgba(24, 43, 73, 0.82);
    content: "";
    height: 2.1rem;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-48%) rotate(45deg);
    width: 2.1rem;
  }

  .estate-section {
    background: #ede8dd;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .estate-section__content {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(var(--space-12), 8vw, var(--space-20)) var(--space-6);
  }

  .estate-section__header {
    align-items: end;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.75fr);
    gap: var(--space-12);
  }

  .estate-section__content h2 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.08;
    margin-bottom: var(--space-6);
  }

  .estate-section__content h1 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.08;
    margin-bottom: var(--space-6);
  }

  .estate-section__header p {
    color: var(--color-body);
    font-size: var(--text-lg);
    line-height: 1.7;
    max-width: 34rem;
  }

  .estate-section__note {
    align-items: center;
    background: var(--color-indigo);
    color: var(--color-white);
    display: grid;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-10, 2.5rem);
    padding: var(--space-6) var(--space-8);
  }

  .estate-section__note strong {
    color: var(--color-gold);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .estate-section__note span {
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .estate-process {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    max-width: 48rem;
  }

  .estate-process li {
    border-top: 1px solid var(--color-border);
    color: var(--color-body);
    font-size: var(--text-sm);
    line-height: 1.7;
    padding-top: var(--space-4);
  }

  .estate-process strong {
    color: var(--color-indigo);
    display: inline;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    margin-right: var(--space-2);
  }

  .restoration-section {
    background: #f7f4ee;
    padding-block: var(--space-20);
  }

  .restoration-section__header {
    margin-bottom: var(--space-8);
  }

  .restoration-section__header h2 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.08;
    max-width: 50rem;
  }

  .restoration-section__header p {
    color: var(--color-body);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-top: var(--space-4);
    max-width: 46rem;
  }

  .restoration-compare {
    position: relative;
    aspect-ratio: 16 / 9;
    min-height: 420px;
    overflow: hidden;
    background: #111827;
    border: 1px solid var(--color-border);
    box-shadow: 0 24px 70px rgba(24, 43, 73, 0.12);
    isolation: isolate;
  }

  .restoration-compare__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .restoration-compare__after {
    position: absolute;
    inset: 0;
    width: 100%;
    clip-path: inset(0 50% 0 0);
    z-index: 2;
  }

  .restoration-compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: var(--color-white);
    transform: translateX(-50%);
    z-index: 4;
  }

  .restoration-compare__handle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    background:
      linear-gradient(45deg, transparent 42%, var(--color-white) 42% 58%, transparent 58%) 12px 50% / 8px 8px no-repeat,
      linear-gradient(225deg, transparent 42%, var(--color-white) 42% 58%, transparent 58%) 26px 50% / 8px 8px no-repeat,
      rgba(24, 43, 73, 0.72);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.24);
    transform: translate(-50%, -50%);
    backdrop-filter: blur(8px);
  }

  .restoration-compare__range {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
  }

  .restoration-compare__label {
    position: absolute;
    top: var(--space-6);
    z-index: 6;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-indigo);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    padding: 0.65rem 0.85rem;
    text-transform: uppercase;
  }

  .restoration-compare__label--before {
    left: var(--space-6);
  }

  .restoration-compare__label--after {
    right: var(--space-6);
  }

  .manifesto-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    align-items: stretch;
    min-height: 560px;
    background: #ebe5da;
    margin-top: var(--space-16);
  }

  .manifesto-section__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .manifesto-section__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(var(--space-12), 8vw, var(--space-24));
  }

  .sticky-story {
    background: var(--color-indigo);
    color: var(--color-white);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    margin-top: var(--space-16);
    min-height: 180vh;
  }

  .sticky-story__media {
    height: calc(100vh - 82px);
    position: sticky;
    top: 82px;
  }

  .sticky-story__media::after {
    background: linear-gradient(90deg, rgba(24, 43, 73, 0.08), rgba(24, 43, 73, 0.34));
    content: "";
    inset: 0;
    position: absolute;
  }

  .sticky-story__media img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .sticky-story__content {
    display: grid;
    gap: var(--space-20);
    padding: clamp(var(--space-16), 10vw, var(--space-24)) clamp(var(--space-6), 7vw, var(--space-20));
  }

  .sticky-story__content article {
    align-content: center;
    display: grid;
    min-height: 72vh;
  }

  .sticky-story__content h2 {
    color: var(--color-white);
    font-size: clamp(var(--text-3xl), 5vw, 5rem);
    font-weight: 400;
    line-height: 1.02;
    max-width: 42rem;
  }

  .sticky-story__content p {
    color: rgba(255, 255, 255, 0.76);
    font-size: var(--text-lg);
    line-height: 1.75;
    margin-top: var(--space-6);
    max-width: 36rem;
  }

  .positioning-section {
    background: var(--color-sand);
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
  }

  .positioning-section__grid,
  .about-definition__grid,
  .brand-architecture__grid {
    align-items: start;
    display: grid;
    gap: clamp(var(--space-8), 7vw, var(--space-16));
    grid-template-columns: minmax(0, 0.85fr) minmax(320px, 1fr);
  }

  .positioning-section h2,
  .about-definition h2,
  .brand-architecture h2 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.08;
  }

  .positioning-section__copy {
    display: grid;
    gap: var(--space-6);
  }

  .positioning-section__copy p,
  .about-definition__copy p {
    color: var(--color-body);
    font-size: var(--text-lg);
    line-height: 1.75;
  }

  .positioning-section__quote {
    border-left: 3px solid var(--color-gold);
    color: var(--color-indigo) !important;
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl)) !important;
    line-height: 1.12 !important;
    padding-left: var(--space-6);
  }

  .measures-section {
    background: var(--color-cream);
    border-block: 1px solid rgba(24, 43, 73, 0.08);
    overflow: hidden;
    padding-block: clamp(var(--space-14, 3.5rem), 7vw, var(--space-20));
  }

  .measures-section__header {
    margin-bottom: var(--space-8);
  }

  .measures-section__header h2 {
    color: var(--color-indigo);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1.08;
    max-width: 42rem;
  }

  .measures-carousel {
    overflow-x: auto;
    padding-block: var(--space-2);
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .measures-carousel::-webkit-scrollbar {
    display: none;
  }

  .measures-carousel__track {
    animation: measures-scroll 52s linear infinite;
    display: flex;
    gap: clamp(var(--space-5), 2.4vw, var(--space-9));
    padding-inline: max(var(--space-6), calc((100vw - var(--container-max)) / 2 + var(--space-6)));
    width: max-content;
  }

  .measures-carousel:hover .measures-carousel__track {
    animation-play-state: paused;
  }

  .measures-carousel article {
    background: var(--color-indigo);
    color: var(--color-white);
    flex: 0 0 clamp(320px, 31vw, 470px);
    min-height: clamp(430px, 43vw, 610px);
    overflow: hidden;
    position: relative;
  }

  .measures-carousel article:nth-child(3n + 2) {
    margin-top: clamp(var(--space-8), 4vw, var(--space-14));
  }

  .measures-carousel article:nth-child(3n) {
    margin-top: clamp(var(--space-4), 2vw, var(--space-8));
  }

  .measures-carousel article::after {
    background:
      linear-gradient(180deg, rgba(10, 20, 32, 0.06), rgba(10, 20, 32, 0.7)),
      linear-gradient(90deg, rgba(10, 20, 32, 0.58), rgba(10, 20, 32, 0.1) 68%);
    content: "";
    inset: 0;
    position: absolute;
    z-index: 1;
  }

  .measures-carousel img {
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    transform: scale(1.01);
    transition: transform 0.8s ease;
    width: 100%;
  }

  .measures-carousel article:hover img {
    transform: scale(1.06);
  }

  .measures-carousel__content {
    bottom: clamp(var(--space-8), 3.8vw, var(--space-12));
    display: grid;
    left: clamp(var(--space-8), 3.8vw, var(--space-12));
    max-width: min(20rem, calc(100% - clamp(5rem, 8vw, 6rem)));
    position: absolute;
    right: clamp(var(--space-8), 3.8vw, var(--space-12));
    z-index: 2;
  }

  .measures-carousel span {
    color: rgba(255, 255, 255, 0.72);
    display: block;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-5);
  }

  .measures-carousel h3 {
    color: var(--color-white);
    font-size: clamp(var(--text-3xl), 3.2vw, var(--text-5xl));
    font-weight: 400;
    line-height: 1;
  }

  .measures-carousel p {
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(var(--text-sm), 1vw, var(--text-base));
    line-height: 1.55;
    margin-top: var(--space-4);
  }

  @keyframes measures-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - var(--space-2)));
    }
  }

  .living-territory {
    align-items: center;
    background: #0a1420;
    color: var(--color-white);
    display: flex;
    justify-content: center;
    min-height: min(860px, calc(100vh - 82px));
    overflow: hidden;
    position: relative;
    text-align: center;
  }

  .living-territory::after {
    background:
      radial-gradient(circle at 50% 52%, rgba(10, 20, 32, 0.12), rgba(10, 20, 32, 0.46) 58%, rgba(10, 20, 32, 0.72)),
