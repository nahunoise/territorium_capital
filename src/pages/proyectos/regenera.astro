---
import Layout from '../../layouts/Layout.astro';
import PageStyles from '../../components/PageStyles.astro';
---

<Layout
  title="REGENERA | Territorium Capital x GestLand"
  description="REGENERA es un proyecto de Territorium Capital en colaboración con GestLand para validar, estructurar y gestionar activos rurales y de capital natural."
  canonicalPath="/proyectos/regenera/"
>
  <PageStyles />

  <main>
    <section class="regenera-hero page-first-section reveal">
      <div class="regenera-hero__media" aria-hidden="true">
        <img src="/imagenes/servicio-capital-natural.jpg" alt="">
      </div>
      <div class="regenera-hero__content">
        <span class="section-kicker section-kicker--light">Proyecto</span>
        <h1>REGENERA</h1>
        <p class="regenera-hero__lead">
          Natural Capital Asset Management para activos rurales.
        </p>
        <p>
          Una plataforma de validación y gestión patrimonial que convierte
          activos rurales complejos en decisiones de capital trazables,
          comparables y ejecutables.
        </p>
        <div class="regenera-hero__partners" aria-label="Colaboracion">
          <span>Territorium Capital</span>
          <strong>x</strong>
          <span>GestLand</span>
        </div>
      </div>
    </section>

    <section class="regenera-intro reveal">
      <div class="container regenera-intro__grid">
        <div>
          <span class="section-kicker">Por que REGENERA</span>
          <h2>Del activo rural aislado a una cartera patrimonial gestionada con criterio.</h2>
        </div>
        <div class="regenera-intro__copy">
          <p>
            REGENERA nace para ordenar el proceso de originación, análisis,
            adquisición, gestión y creación de valor de activos rurales con
            potencial económico, ecológico y patrimonial.
          </p>
          <p>
            El objetivo es construir una lectura completa del activo: que es,
            que permite, como funciona, que riesgos tiene y que estrategia puede
            convertirlo en patrimonio mejor gestionado.
          </p>
        </div>
      </div>
    </section>

    <section class="regenera-method reveal">
      <div class="container">
        <div class="section-heading section-heading--left">
          <span class="section-kicker">Metodo</span>
          <h2>Un expediente técnico y distintas lecturas según la decisión.</h2>
          <p>
            REGENERA trabaja con evidencia separada de conclusiones, para que
            cada decisión pueda revisarse, compararse y sostenerse.
          </p>
        </div>

        <div class="regenera-steps">
          <article>
            <span>M0</span>
            <h3>Mandato</h3>
            <p>Definir objetivo, perfil de activo, criterios y límites de decisión.</p>
          </article>
          <article>
            <span>V0</span>
            <h3>Encaje</h3>
            <p>Comprobar si el activo merece avanzar antes de consumir recursos.</p>
          </article>
          <article>
            <span>V1</span>
            <h3>Prevalidación</h3>
            <p>Revisar información clave, riesgos iniciales y potencial patrimonial.</p>
          </article>
          <article>
            <span>V2</span>
            <h3>Validacion dirigida</h3>
            <p>Profundizar en el activo según la decisión: comprar, vender, operar o coinvertir.</p>
          </article>
          <article>
            <span>V3</span>
            <h3>Cierre</h3>
            <p>Acompañar diligencia, condiciones, estructura y siguiente fase de gestión.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="regenera-analysis reveal">
      <div class="container regenera-analysis__grid">
        <div class="regenera-analysis__media">
          <img src="/imagenes/servicio-diagnostico-capas.png" alt="Analisis territorial con capas ambientales y productivas">
        </div>
        <div class="regenera-analysis__copy">
          <span class="section-kicker">Qué analiza</span>
          <h2>La realidad completa del activo.</h2>
          <ul>
            <li>Identidad, perímetro y documentación de base.</li>
            <li>Condición jurídica, urbanística y regulatoria.</li>
            <li>Agua, infraestructuras, accesos y capacidad operativa.</li>
            <li>Economía actual, mercado, valoración y escenarios.</li>
            <li>Capital natural, restauración, resiliencia y oportunidades de mejora.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="regenera-value reveal">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">Creación de valor</span>
          <h2>Comprar bien, gestionar mejor y regenerar con visión patrimonial.</h2>
        </div>
        <div class="regenera-value__grid">
          <article>
            <span>01</span>
            <h3>Validacion</h3>
            <p>Reducir incertidumbre antes de tomar decisiones de adquisición, venta o gestión.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Estructura</h3>
            <p>Ordenar activos, condiciones, responsabilidades y escenarios de ejecución.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Gestion</h3>
            <p>Optimizar ingresos, control, mantenimiento, proveedores y hoja de ruta.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Regeneracion</h3>
            <p>Mejorar suelo, agua, biodiversidad, paisaje y resiliencia del territorio.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="regenera-collab reveal">
      <div class="container regenera-collab__grid">
        <div>
          <span class="section-kicker section-kicker--light">Colaboracion</span>
          <h2>Territorium aporta criterio patrimonial. GestLand aporta experiencia operativa rural.</h2>
        </div>
        <div class="regenera-collab__cards">
          <article>
            <h3>Territorium Capital</h3>
            <p>
              Estrategia patrimonial, capital natural, tecnología territorial y
              enfoque de resiliencia para convertir el potencial ecológico en
              decisión.
            </p>
          </article>
          <article>
            <h3>GestLand</h3>
            <p>
              Conocimiento de campo, valoracion rural y lectura operativa para
              contrastar la viabilidad real de cada activo.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="regenera-disclaimer reveal">
      <div class="container">
        <p>
          REGENERA no se presenta como fondo ni como producto financiero
          regulado. Cada operación requiere análisis jurídico, fiscal,
          financiero y técnico independiente antes de cualquier decisión.
        </p>
        <a href="/contacto/" class="seo-cta">Solicitar conversación</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
          currentObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll(".reveal").forEach(el => observer.observe(el));
  });
</script>
