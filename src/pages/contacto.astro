---
import Layout from '../layouts/Layout.astro';
import PageStyles from '../components/PageStyles.astro';
---

<Layout
  title="Contacto | Territorium Capital"
  description="Contacto de Territorium Capital para propietarios, empresas, inversores e instituciones que quieren valorar una oportunidad ligada a territorio, capital natural o restauración."
  canonicalPath="/contacto/"
>
  <PageStyles />

  <main>
    <section class="problem-section page-first-section reveal">
      <div class="container editorial-grid">
        <div>
          <span class="section-kicker">Contacto</span>
          <h1>Hablemos del enfoque adecuado.</h1>
        </div>
        <div class="editorial-copy">
          <p>
            Si está valorando un territorio, una inversión, una operación o un
            proyecto de capital natural, el primer paso es entender bien el
            objetivo y la decisión que hay que tomar.
          </p>
          <p>
            Puede escribir directamente a
            <a href="mailto:blanca@territorium.capital">blanca@territorium.capital</a>
            o contactar por WhatsApp en el
            <a href="https://wa.me/34646051005" target="_blank" rel="noopener noreferrer">+34 646 051 005</a>.
          </p>
          <div class="seo-page-hero__actions">
            <a class="seo-cta" href="/analizar-mi-territorio/">Enviar información del proyecto</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
          currentObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll(".reveal").forEach(el => observer.observe(el));
  });
</script>
