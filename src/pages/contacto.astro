---
import Layout from '../layouts/Layout.astro';
import PageStyles from '../components/PageStyles.astro';
---

<Layout
  title="Contacto | Territorium Capital"
  description="Contacto de Territorium Capital. Para analizar un territorio, utilice el formulario principal de diagnóstico territorial."
  canonicalPath="/contacto/"
>
  <PageStyles />

  <main>
    <section class="problem-section page-first-section reveal">
      <div class="container editorial-grid">
        <div>
          <span class="section-kicker">Contacto</span>
          <h1>Un único punto de entrada para estudiar su territorio.</h1>
        </div>
        <div class="editorial-copy">
          <p>
            Para valorar una finca, territorio, operación o proyecto de capital
            natural, utilice el formulario de análisis. Nos ayuda a entender el
            contexto desde el primer mensaje y responder con más criterio.
          </p>
          <p>
            También puede escribir directamente a
            <a href="mailto:blanca@territorium.capital">blanca@territorium.capital</a>
            o contactar por WhatsApp en el
            <a href="https://wa.me/34646051005" target="_blank" rel="noopener noreferrer">+34 646 051 005</a>.
          </p>
          <div class="seo-page-hero__actions">
            <a class="seo-cta" href="/analizar-mi-finca/">Analizar mi territorio</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
          currentObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll(".reveal").forEach(el => observer.observe(el));
  });
</script>
