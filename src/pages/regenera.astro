---
const title = 'REGENERA | Natural Capital Asset Management';
const description = 'REGENERA integra capital natural, gestión especializada y regeneración productiva para preservar y crear valor a largo plazo en grandes dehesas y activos rurales singulares.';

const valueSteps = [
  ['01', 'Comprar bien', 'Identificar activos con encaje real antes de comprometer capital, tiempo y estructura.'],
  ['02', 'Optimizar ingresos', 'Ordenar rentas, usos, costes, contratos y oportunidades existentes del activo.'],
  ['03', 'Gestionar con control', 'Convertir la finca en un activo con presupuesto, indicadores, responsables y seguimiento.'],
  ['04', 'Regenerar capital natural', 'Mejorar agua, suelo, arbolado, biodiversidad y resiliencia del territorio.'],
  ['05', 'Elevar valor patrimonial', 'Construir una tesis de largo plazo: más resiliente, más trazable y mejor defendible.'],
];

const method = [
  ['Originación', 'Localizamos activos rurales con escala, calidad territorial y potencial patrimonial.'],
  ['Validación', 'Analizamos el activo desde mercado, documentación, agua, suelo, biodiversidad, producción y riesgos.'],
  ['Adquisición', 'Acompañamos la decisión de compra con una tesis clara de valor y escenarios de actuación.'],
  ['Asset Management', 'Gestionamos el activo con presupuesto, plan de negocio, CAPEX, proveedores e indicadores.'],
  ['Portfolio Management', 'Comparamos fincas, priorizamos inversiones y construimos una cartera rural coherente.'],
];

const indicators = [
  'Agua',
  'Suelo',
  'Arbolado',
  'Biodiversidad',
  'Rentas',
  'CAPEX',
  'Riesgo climático',
  'Valor patrimonial',
];

const regeneraModel = [
  {
    title: 'Selección estratégica',
    text: 'Identificamos grandes dehesas, activos agroforestales, oportunidades singulares y territorios con potencial de mejora.',
    items: ['Grandes dehesas', 'Activos agroforestales', 'Operaciones reservadas', 'Alto valor ecológico'],
  },
  {
    title: 'Regeneración productiva',
    text: 'Diseñamos planes de medio y largo plazo para mejorar el funcionamiento ecológico y operativo del activo.',
    items: ['Restauración ecológica', 'Protección del arbolado', 'Mejora de suelos', 'Custodia del territorio'],
  },
  {
    title: 'Gestión especializada',
    text: 'Acompañamos la dirección técnica y patrimonial del territorio con una lectura completa de usos, rentas y riesgos.',
    items: ['Ganadería extensiva', 'Agua y recursos hídricos', 'Corcho y montanera', 'Biodiversidad y resiliencia'],
  },
  {
    title: 'Creación de valor',
    text: 'Seguimos el activo con métricas financieras, operativas, ambientales y territoriales para decidir con evidencia.',
    items: ['Indicadores financieros', 'KPIs operativos', 'Métricas ambientales', 'Seguimiento institucional'],
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/imagenes/medidas/nuevas/paisaje-spain.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/imagenes/regenera-logo-lockup-light-strong.png" />
    <link rel="preload" as="video" href="/videos/premium/hero-bosque-luz.mp4" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="regenera-nav" aria-label="Navegación REGENERA">
      <a href="#inicio" class="regenera-nav__brand" aria-label="REGENERA inicio">
        <img src="/imagenes/regenera-logo-lockup.png" alt="REGENERA">
      </a>
      <div class="regenera-nav__links">
        <a href="#que-es">Qué es</a>
        <a href="#metodo">Método</a>
        <a href="#valor">Valor</a>
        <a href="#contacto">Contacto</a>
      </div>
      <a href="/proyectos/regenera/" class="regenera-nav__territorium">Proyecto Territorium</a>
    </nav>

    <header id="inicio" class="regenera-hero">
      <div class="regenera-hero__videos" aria-hidden="true">
        <video class="regenera-video is-active" muted playsinline autoplay loop preload="auto" poster="/imagenes/medidas/nuevas/paisaje-spain.jpg">
          <source src="/videos/premium/hero-bosque-luz.mp4" type="video/mp4" />
        </video>
        <video class="regenera-video" muted playsinline loop preload="none" poster="/imagenes/fondo-3.webp">
          <source data-src="/videos/premium/hero-montana-territorio.mp4" type="video/mp4" />
        </video>
        <video class="regenera-video" muted playsinline loop preload="none" poster="/imagenes/medidas/riesgo-seco.jpg">
          <source data-src="/videos/premium/hero-ribera-seca.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="regenera-hero__veil" aria-hidden="true"></div>
      <div class="regenera-hero__content">
        <img class="regenera-hero__logo" src="/imagenes/regenera-logo-lockup-light-strong.png" alt="REGENERA">
        <span class="eyebrow">Natural Capital · Real Assets · Real Impact</span>
        <h1>Conservar produciendo. Producir regenerando.</h1>
      </div>
    </header>

    <section class="hero-summary" aria-label="Enfoque REGENERA">
      <div class="hero-summary__intro">
        <p>
          Una visión institucional para los activos rurales del futuro:
          capital natural, gestión especializada y regeneración productiva.
        </p>
        <div class="hero-actions hero-summary__actions">
          <a href="#contacto">Analizar un activo</a>
          <a href="#que-es">Ver enfoque</a>
        </div>
      </div>
      <div class="regenera-hero__cards" aria-label="Pilares REGENERA">
        <article>
          <span>Acceso</span>
          <p>Grandes dehesas y activos rurales singulares con lectura patrimonial.</p>
        </article>
        <article>
          <span>Experiencia</span>
          <p>Capital natural, gestión patrimonial y operaciones reservadas.</p>
        </article>
        <article>
          <span>Administración</span>
          <p>Gestión orientada a preservar y crear valor a largo plazo.</p>
        </article>
      </div>
    </section>

    <main>
      <section id="que-es" class="editorial-section intro-section reveal">
        <div class="section-label">Qué es REGENERA</div>
        <div class="intro-section__grid">
          <h2>Una plataforma institucional para preservar, regenerar y transmitir capital natural.</h2>
          <div class="intro-section__copy">
            <p>
              REGENERA integra capital natural, gestión especializada y regeneración
              productiva para preservar y crear valor a largo plazo en grandes
              dehesas y activos rurales singulares.
            </p>
            <p>
              Entendemos la dehesa como un patrimonio vivo: un activo real que debe
              equilibrar rentabilidad, biodiversidad, impacto territorial y legado
              bajo una visión profesional de largo plazo.
            </p>
          </div>
        </div>
      </section>

      <section class="partners-band reveal" aria-label="Capacidades de la colaboración">
        <div class="partners-band__visual">
          <img src="/imagenes/regenera-dehesa-camino.jpg" alt="Dehesa con encinas y camino rural">
        </div>
        <div class="partners-band__content">
          <span class="section-label">Territorium × GestLand</span>
          <h2>Mercado rural, capital natural y medición bajo una misma tesis de valor.</h2>
          <div class="partners-band__cards">
            <article>
              <img src="/imagenes/Territorium_Capital_logo.png" alt="Territorium Capital">
              <p>Capital natural, tecnología territorial, mapas, indicadores y estrategia de resiliencia.</p>
            </article>
            <article>
              <img src="/imagenes/gestland-logo.png" alt="GestLand">
              <p>Conocimiento del activo rural, valoración, mercado y acceso a oportunidades.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="image-triptych reveal" aria-label="Ámbitos de REGENERA">
        <a href="#metodo" class="image-triptych__item image-triptych__item--left">
          <img src="/imagenes/medidas/nuevas/paisaje-spain.jpg" alt="Paisaje rural de gran escala">
          <span>Territorio</span>
        </a>
        <a href="#valor" class="image-triptych__item image-triptych__item--center">
          <img src="/imagenes/medidas/nuevas/capital-natural-rural.jpg" alt="Mosaico rural y capital natural">
          <span>Capital natural</span>
        </a>
        <a href="#datos" class="image-triptych__item image-triptych__item--right">
          <img src="/imagenes/servicio-diagnostico-capas.png" alt="Mapa de diagnóstico territorial con capas">
          <span>Datos</span>
        </a>
      </section>

      <section class="model-section reveal" aria-label="Modelo REGENERA">
        <div class="model-section__header">
          <span class="section-label">El modelo REGENERA</span>
          <h2>Preservamos ecosistemas excepcionales. Creamos valor para las próximas generaciones.</h2>
        </div>
        <div class="model-grid">
          {regeneraModel.map((block, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{block.title}</h3>
              <p>{block.text}</p>
              <ul>
                {block.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section id="valor" class="value-section reveal">
        <div class="value-section__image" aria-hidden="true">
          <img src="/imagenes/regenera-dehesa-camino.jpg" alt="">
        </div>
        <div class="value-section__content">
          <span class="section-label">Creación de valor</span>
          <h2>Del activo rural al patrimonio gestionado.</h2>
          <p>
            La lógica es sencilla: seleccionar mejor, ordenar lo existente, gestionar
            con control, regenerar el capital natural y sostener una valoración más sólida.
          </p>
          <div class="value-timeline">
            {valueSteps.map(([number, heading, text]) => (
              <article>
                <span>{number}</span>
                <h3>{heading}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="metodo" class="method-section reveal">
        <div class="method-section__header">
          <span class="section-label">Método REGENERA</span>
          <h2>Un ciclo completo, del análisis a la gestión.</h2>
          <p>
            Cada activo se decide individualmente, pero se gestiona con una disciplina
            común: información comparable, hipótesis claras y seguimiento.
          </p>
        </div>
        <div class="method-track">
          {method.map(([heading, text], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{heading}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="datos" class="index-section reveal">
        <video class="index-section__video" data-lazy-video muted playsinline loop preload="none" poster="/imagenes/medidas/fauna-salvaje.jpg">
          <source data-src="/videos/buitre-leonado-vuelo.mp4" type="video/mp4" />
        </video>
        <div class="index-section__overlay" aria-hidden="true"></div>
        <div class="index-section__content">
          <span class="section-label section-label--light">REGENERA Index</span>
          <h2>Primero medimos. Luego afirmamos.</h2>
          <p>
            El territorio se lee como un activo vivo: agua, suelo, arbolado,
            biodiversidad, rentas, riesgos, CAPEX y potencial de regeneración,
            siempre con métricas financieras, operativas y ambientales.
          </p>
          <div class="indicator-cloud">
            {indicators.map((indicator) => <span>{indicator}</span>)}
          </div>
        </div>
      </section>

      <section class="portfolio-section reveal">
        <div>
          <span class="section-label">Cartera patrimonial</span>
          <h2>Del activo único a una cartera rural con criterio común.</h2>
        </div>
        <div class="portfolio-section__body">
          <p>
            REGENERA permite comparar fincas, inversiones, proveedores, riesgos,
            rentas, actuaciones y métricas de capital natural. Cada territorio mantiene
            su autonomía, pero la gestión se profesionaliza bajo una visión común.
          </p>
          <div class="portfolio-metrics" aria-label="Criterios de gestión">
            <article><strong>SPV</strong><span>por activo</span></article>
            <article><strong>KPIs</strong><span>de gestión</span></article>
            <article><strong>CAPEX</strong><span>priorizado</span></article>
            <article><strong>MRV</strong><span>medición y seguimiento</span></article>
          </div>
        </div>
      </section>

      <section id="contacto" class="closing-section reveal">
        <div class="closing-section__inner">
          <span class="section-label section-label--light">Siguiente paso</span>
          <h2>Analicemos si su territorio puede funcionar mejor.</h2>
          <p>
            Contacto reservado para propietarios, family offices y organizaciones
            que quieran preservar, regenerar o poner en valor un gran activo rural.
          </p>
          <div class="closing-actions">
            <a href="mailto:blanca@territorium.capital?subject=REGENERA%20-%20Analizar%20activo%20rural">blanca@territorium.capital</a>
            <a href="/proyectos/regenera/">Ver ficha en Territorium</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="regenera-footer">
      <span>REGENERA</span>
      <p>Natural Capital · Real Assets · Real Impact</p>
      <p>Proyecto impulsado por Territorium Capital y GestLand.</p>
    </footer>

    <script>
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));

      const lazyVideoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const video = entry.target;
          video.querySelectorAll('source[data-src]').forEach((source) => {
            source.src = source.dataset.src;
            source.removeAttribute('data-src');
          });
          video.load();
          video.play().catch(() => {});
          lazyVideoObserver.unobserve(video);
        });
      }, { rootMargin: '240px 0px' });

      document.querySelectorAll('[data-lazy-video]').forEach((video) => lazyVideoObserver.observe(video));

      const heroVideos = Array.from(document.querySelectorAll('.regenera-video'));
      let activeVideo = 0;

      const loadHeroVideo = (video) => {
        video.querySelectorAll('source[data-src]').forEach((source) => {
          source.src = source.dataset.src;
          source.removeAttribute('data-src');
        });
        if (!video.dataset.loaded) {
          video.load();
          video.dataset.loaded = 'true';
        }
      };

      heroVideos.forEach((video, index) => {
        if (index < 2) loadHeroVideo(video);
        video.play().catch(() => {});
      });

      window.setInterval(() => {
        if (heroVideos.length < 2) return;
        const previous = heroVideos[activeVideo];
        activeVideo = (activeVideo + 1) % heroVideos.length;
        const next = heroVideos[activeVideo];
        loadHeroVideo(next);
        next.currentTime = 0;
        next.play().catch(() => {});
        previous.classList.remove('is-active');
        next.classList.add('is-active');
      }, 5200);
    </script>
  </body>
</html>

<style>
  :root {
    --green-deep: #0e2018;
    --green-brand: #1f4433;
    --green-live: #2f6650;
    --gold: #c9a24a;
    --bone: #efe7d6;
    --bone-soft: #f7f1e5;
    --ink: #17241d;
    --muted: rgba(23, 36, 29, 0.68);
    --white: #fffaf0;
    --line: rgba(14, 32, 24, 0.16);
    --display: Georgia, 'Times New Roman', serif;
    --sans: 'Segoe UI', Helvetica, Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bone);
    color: var(--ink);
    font-family: var(--sans);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    overflow-x: hidden;
  }

  body::selection {
    background: var(--gold);
    color: var(--green-deep);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  video {
    display: block;
    max-width: 100%;
  }

  .regenera-nav {
    align-items: center;
    background: rgba(239, 231, 214, 0.96);
    border-bottom: 1px solid rgba(14, 32, 24, 0.12);
    backdrop-filter: blur(16px);
    display: grid;
    grid-template-columns: minmax(130px, 190px) 1fr auto;
    gap: clamp(1rem, 3vw, 3rem);
    left: 0;
    padding: 1rem clamp(1rem, 4vw, 3.5rem);
    position: fixed;
    right: 0;
    top: 0;
    z-index: 20;
  }

  .regenera-nav__brand img {
    height: auto;
    max-height: 54px;
    object-fit: contain;
    object-position: left center;
    width: min(280px, 52vw);
  }

  .regenera-nav__links {
    align-items: center;
    display: flex;
    gap: clamp(0.9rem, 2vw, 2rem);
    justify-content: center;
  }

  .regenera-nav a {
    color: var(--green-deep);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .regenera-nav__territorium {
    border: 1px solid rgba(14, 32, 24, 0.22);
    padding: 0.8rem 1rem;
  }

  .regenera-hero {
    background: var(--green-deep);
    color: var(--white);
    min-height: 100svh;
    overflow: hidden;
    padding: clamp(8rem, 13vw, 11rem) clamp(1.25rem, 6vw, 5.5rem) clamp(6rem, 10vw, 9rem);
    position: relative;
  }

  .regenera-hero__videos,
  .regenera-video,
  .regenera-hero__veil {
    inset: 0;
    position: absolute;
  }

  .regenera-video {
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.02);
    transition: opacity 1.6s ease;
    width: 100%;
  }

  .regenera-video.is-active {
    animation: heroDrift 5.6s linear forwards;
    opacity: 1;
  }

  @keyframes heroDrift {
    from { transform: scale(1.015) translate3d(0, 0, 0); }
    to { transform: scale(1.055) translate3d(-0.7%, -0.45%, 0); }
  }

  .regenera-hero__veil {
    background:
      linear-gradient(90deg, rgba(14, 32, 24, 0.92), rgba(14, 32, 24, 0.54) 48%, rgba(14, 32, 24, 0.16)),
      linear-gradient(180deg, rgba(14, 32, 24, 0.24), rgba(14, 32, 24, 0.72));
  }

  .regenera-hero__content {
    max-width: min(62rem, calc(100vw - clamp(2.5rem, 12vw, 11rem)));
    position: relative;
    z-index: 2;
  }

  .regenera-hero__logo {
    height: auto;
    filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.42));
    margin-bottom: clamp(2.3rem, 5vw, 4.4rem);
    max-width: min(560px, 76vw);
    width: 100%;
  }

  .eyebrow,
  .section-label {
    color: var(--gold);
    display: block;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    margin-bottom: 1.1rem;
    text-transform: uppercase;
  }

  .section-label--light {
    color: rgba(255, 250, 240, 0.76);
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2 {
    font-family: var(--display);
    font-weight: 400;
    letter-spacing: 0;
  }

  .regenera-hero h1 {
    font-size: clamp(3.1rem, 7.2vw, 8rem);
    line-height: 0.96;
    max-width: 52rem;
  }

  .hero-actions,
  .closing-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.8rem;
  }

  .hero-actions a,
  .closing-actions a {
    border: 1px solid rgba(255, 250, 240, 0.72);
    color: var(--white);
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 900;
    justify-content: center;
    letter-spacing: 0.16em;
    min-width: 13rem;
    padding: 1rem 1.25rem;
    text-transform: uppercase;
  }

  .hero-actions a:first-child,
  .closing-actions a:first-child {
    background: var(--bone);
    border-color: var(--bone);
    color: var(--green-deep);
  }

  .regenera-hero__cards {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
  }

  .regenera-hero__cards article {
    background: rgba(239, 231, 214, 0.92);
    color: var(--green-deep);
    min-height: 9rem;
    padding: 1.3rem;
  }

  .regenera-hero__cards span {
    color: var(--green-brand);
    display: block;
    font-family: var(--display);
    font-size: 1.45rem;
    margin-bottom: 0.75rem;
  }

  .regenera-hero__cards p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }

  .hero-summary {
    align-items: stretch;
    background: var(--bone);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: clamp(2rem, 5vw, 6rem);
    grid-template-columns: minmax(0, 0.74fr) minmax(360px, 1fr);
    padding: clamp(2.4rem, 6vw, 5.5rem) clamp(1.25rem, 6vw, 5.5rem);
  }

  .hero-summary__intro {
    align-content: center;
    display: grid;
  }

  .hero-summary__intro p {
    color: var(--green-deep);
    font-family: var(--display);
    font-size: clamp(1.8rem, 3.3vw, 3.5rem);
    line-height: 1.08;
    max-width: 43rem;
  }

  .hero-summary__actions a {
    border-color: var(--green-deep);
    color: var(--green-deep);
  }

  .hero-summary__actions a:first-child {
    background: var(--green-deep);
    border-color: var(--green-deep);
    color: var(--white);
  }

  .editorial-section,
  .method-section,
  .portfolio-section {
    background: var(--bone);
    padding: clamp(5rem, 10vw, 9rem) clamp(1.25rem, 6vw, 5.5rem);
  }

  .intro-section__grid,
  .portfolio-section {
    display: grid;
    gap: clamp(2rem, 6vw, 7rem);
    grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.85fr);
  }

  .intro-section h2,
  .partners-band h2,
  .value-section h2,
  .method-section h2,
  .index-section h2,
  .portfolio-section h2,
