---
import Layout from '../layouts/Layout.astro';
import PageStyles from '../components/PageStyles.astro';
---

<Layout
  title="Gestión patrimonial territorial | Territorium Capital"
  description="Gestión patrimonial territorial para propietarios, empresas e instituciones: capital natural, resiliencia, restauración y valor a largo plazo."
  canonicalPath="/"
  preloadImages={['/imagenes/fondo-1.webp']}
>
  <PageStyles />

  <header class="hero home-hero" id="hero-carousel">
    <div class="hero-video-stage" aria-hidden="true">
      <video class="hero-video is-active" data-hero-video data-loaded="true" muted playsinline webkit-playsinline autoplay loop preload="auto" poster="/imagenes/fondo-1.webp" disablepictureinpicture>
        <source src="/videos/mobile/hero-bosque-luz-mobile.mp4" type="video/mp4" media="(max-width: 640px)" />
        <source src="/videos/premium/hero-bosque-luz.mp4" type="video/mp4" />
      </video>
      <video class="hero-video" data-hero-video muted playsinline webkit-playsinline loop preload="none" poster="/imagenes/fondo-2.webp" disablepictureinpicture>
        <source data-src="/videos/mobile/hero-buitre-vuelo-mobile.mp4" type="video/mp4" media="(max-width: 640px)" />
        <source data-src="/videos/premium/hero-buitre-vuelo.mp4" type="video/mp4" />
      </video>
      <video class="hero-video" data-hero-video muted playsinline webkit-playsinline loop preload="none" poster="/imagenes/fondo-3.webp" disablepictureinpicture>
        <source data-src="/videos/mobile/hero-montana-territorio-mobile.mp4" type="video/mp4" media="(max-width: 640px)" />
        <source data-src="/videos/premium/hero-montana-territorio.mp4" type="video/mp4" />
      </video>
      <video class="hero-video" data-hero-video muted playsinline webkit-playsinline loop preload="none" poster="/imagenes/medidas/riesgo-seco.jpg" disablepictureinpicture>
        <source data-src="/videos/mobile/hero-ribera-seca-mobile.mp4" type="video/mp4" media="(max-width: 640px)" />
        <source data-src="/videos/premium/hero-ribera-seca.mp4" type="video/mp4" />
      </video>
      <div class="hero-video-stage__overlay"></div>
    </div>
    <div class="hero__content">
      <span class="hero__eyebrow">Gestora patrimonial territorial</span>
      <h1 class="hero__title fade-in" id="carousel-title">
        Capital natural para decidir mejor.
      </h1>
      <p class="hero__subtitle fade-in" id="carousel-subtitle">
        Ayudamos a propietarios y gestores de terrenos públicos y privados a
        aumentar la resiliencia, rentabilidad y valor natural de sus activos.
      </p>
      <div class="hero__actions">
        <a href="/contacto/" class="hero__cta">Hablemos</a>
        <a href="/sobre-territorium/" class="hero__cta hero__cta--primary">Sobre Territorium</a>
      </div>
    </div>
  </header>

  <main>
    <section class="service-finder reveal" aria-label="Necesidades principales">
      <div class="container">
        <span class="service-finder__label">Qué necesita</span>
        <div class="service-finder__grid">
          <a href="/valor-ecologico-territorio/" class="service-finder__item">
            <small>01</small>
            <h3>Valorar un territorio</h3>
            <p>Conocer su valor natural, riesgos, potencial y prioridades.</p>
          </a>
          <a href="/servicios/" class="service-finder__item">
            <small>02</small>
            <h3>Mejorar un territorio</h3>
            <p>Aumentar resiliencia, rentabilidad y valor patrimonial.</p>
          </a>
          <a href="/clientes/" class="service-finder__item">
            <small>03</small>
            <h3>Proyecto para mi empresa</h3>
            <p>Crear impacto medible en naturaleza, clima y territorio.</p>
          </a>
          <a href="/proyectos/" class="service-finder__item">
            <small>04</small>
            <h3>Soluciones aplicables</h3>
            <p>Explorar líneas de trabajo ya testadas en proyectos reales.</p>
          </a>
          <a href="/oportunidades/" class="service-finder__item">
            <small>05</small>
            <h3>Ayudas e ingresos</h3>
            <p>Detectar subvenciones, mercados y oportunidades de rentabilidad.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="positioning-section reveal">
      <div class="container positioning-section__grid">
        <div>
          <span class="section-kicker">Qué es Territorium</span>
          <h2>Una gestora patrimonial territorial.</h2>
        </div>
        <div class="positioning-section__copy">
          <p>
            Ayudamos a propietarios y gestores de terrenos públicos y privados,
            empresas e instituciones a entender, gestionar y mejorar el
            funcionamiento ecológico y económico de sus territorios mediante
            ciencia ambiental, tecnología y capacidad de ejecución.
          </p>
          <p class="positioning-section__quote">
            Medimos biodiversidad, agua, suelo, paisaje y riesgo climático para
            convertir capital natural en decisiones de inversión, gestión e impacto.
          </p>
        </div>
      </div>
    </section>

    <section class="measures-section reveal" aria-label="Variables que mide Territorium">
      <div class="container measures-section__header">
        <span class="section-kicker">Qué medimos</span>
        <h2>Lo que no siempre se ve también cuenta.</h2>
      </div>
      <div class="measures-carousel">
        <div class="measures-carousel__track">
          {[0, 1].map(() => (
            <>
              <article>
                <img src="/imagenes/medidas/nuevas/biodiversidad-ciervo.jpg" alt="Fauna salvaje en bosque maduro" loading="lazy" decoding="async">
                <div class="measures-carousel__content">
                  <span>01</span>
                  <h3>Biodiversidad</h3>
                  <p>Fauna, hábitats y mosaico ecológico.</p>
                </div>
              </article>
              <article>
                <img src="/imagenes/medidas/nuevas/agua-rio-aereo.jpg" alt="Río y bosque vistos desde el aire" loading="lazy" decoding="async">
                <div class="measures-carousel__content">
                  <span>02</span>
                  <h3>Agua</h3>
                  <p>Retención, drenaje y comportamiento hídrico.</p>
                </div>
              </article>
              <article>
                <img src="/imagenes/medidas/nuevas/suelo-textura.jpg" alt="Textura de suelo y materia orgánica" loading="lazy" decoding="async">
                <div class="measures-carousel__content">
                  <span>03</span>
                  <h3>Suelo</h3>
                  <p>Erosión, estructura y capacidad de recuperación.</p>
                </div>
              </article>
              <article>
                <img src="/imagenes/medidas/nuevas/paisaje-spain.jpg" alt="Paisaje territorial de montaña al atardecer" loading="lazy" decoding="async">
                <div class="measures-carousel__content">
                  <span>04</span>
                  <h3>Paisaje</h3>
                  <p>Coberturas, usos y lectura patrimonial.</p>
                </div>
              </article>
              <article>
                <img src="/imagenes/medidas/nuevas/conectividad-bosque.jpg" alt="Continuidad de vegetación y caminos naturales desde el aire" loading="lazy" decoding="async">
                <div class="measures-carousel__content">
                  <span>05</span>
                  <h3>Conectividad</h3>
                  <p>Continuidad entre hábitats y zonas clave.</p>
                </div>
              </article>
              <article>
                <img src="/imagenes/medidas/nuevas/riesgo-climatico-sequia.jpg" alt="Suelo seco y agrietado por estrés hídrico" loading="lazy" decoding="async">
                <div class="measures-carousel__content">
                  <span>06</span>
                  <h3>Riesgo climático</h3>
                  <p>Estrés hídrico, exposición y capacidad de respuesta.</p>
                </div>
              </article>
              <article>
                <img src="/imagenes/medidas/nuevas/capital-natural-rural.jpg" alt="Mosaico de agua, suelo, vegetación y usos rurales" loading="lazy" decoding="async">
                <div class="measures-carousel__content">
                  <span>07</span>
                  <h3>Capital natural</h3>
                  <p>Oportunidades ecológicas, económicas y patrimoniales.</p>
                </div>
              </article>
            </>
          ))}
        </div>
      </div>
    </section>

    <section class="living-territory reveal" aria-label="Territorio vivo">
      <video class="living-territory__video" data-lazy-video muted playsinline loop preload="none" poster="/imagenes/medidas/fauna-salvaje.jpg">
        <source data-src="/videos/buitre-leonado-vuelo.mp4" type="video/mp4" />
      </video>
      <div class="living-territory__content">
        <span>Territorio vivo</span>
        <div aria-hidden="true"></div>
        <h2>La biodiversidad es el pulso visible del territorio.</h2>
        <p>
          Donde hay especies, conectividad y hábitat, hay más resiliencia y más valor natural.
        </p>
      </div>
    </section>

    <section class="sticky-story reveal" aria-label="Territorio, legado y resiliencia">
      <div class="sticky-story__media">
        <img src="/imagenes/territorio-legado.jpg" alt="Paisaje natural gestionado por Territorium" loading="lazy" decoding="async">
      </div>
      <div class="sticky-story__content">
        <article>
          <span class="section-kicker">Somos de la tierra</span>
          <h2>Nacemos, vivimos y volvemos a ella.</h2>
          <p>
            Desde la tierra nacen nuestros alimentos, nuestra historia y las
            vidas que viven en ella. Es legado, memoria y futuro.
          </p>
        </article>
        <article>
          <span class="section-kicker">Resiliencia</span>
          <h2>Un territorio que funciona mejor resiste mejor.</h2>
          <p>
            Medimos biodiversidad, agua, suelo y paisaje para entender cómo
            responde cada territorio ante presión climática y cambios de uso.
          </p>
        </article>
        <article>
          <span class="section-kicker">Valor</span>
          <h2>La naturaleza también forma parte del patrimonio.</h2>
          <p>
            Convertimos esa lectura ecológica en una estrategia clara para
            conservar, restaurar, gestionar o poner en valor el territorio.
          </p>
        </article>
      </div>
    </section>

  </main>
</Layout>

<script>
  const slides = [
    {
      image: "/imagenes/fondo-1.webp",
      title: "Capital natural<br/>para decidir mejor.",
      subtitle: "Gestión patrimonial territorial para unir resiliencia, valor e impacto."
    },
    {
      image: "/imagenes/fondo-2.webp",
      title: "Territorios más resilientes.<br/>Activos mejor gestionados.",
      subtitle: "Medimos biodiversidad, agua, suelo y paisaje para anticipar riesgos y activar oportunidades."
    },
    {
      image: "/imagenes/fondo-3.webp",
      title: "Ciencia, datos<br/>y ejecución sobre el terreno.",
      subtitle: "Del diagnóstico a proyectos reales de restauración, gestión e inversión en capital natural."
    },
    {
      image: "/imagenes/medidas/riesgo-seco.jpg",
      title: "Resiliencia climática<br/>con base territorial.",
      subtitle: "Acompañamos a empresas, propietarios e instituciones en decisiones con impacto medible."
    }
  ];

  let currentIndex = 0;
  let currentVideoIndex = 0;
  let carouselTimer: number | undefined;
  const heroElement = document.getElementById('hero-carousel') as HTMLElement;
  const titleElement = document.getElementById('carousel-title') as HTMLElement;
  const subtitleElement = document.getElementById('carousel-subtitle') as HTMLElement;
  const videoElements = Array.from(document.querySelectorAll('[data-hero-video]')) as HTMLVideoElement[];
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const shouldLoadBackgroundMedia = !connection?.saveData && !['slow-2g', '2g'].includes(connection?.effectiveType ?? '');
  const scheduleIdle = window.requestIdleCallback ?? ((callback: IdleRequestCallback) => window.setTimeout(callback, 250));

  const heroGradient = "linear-gradient(90deg, rgba(10,20,32,0.82), rgba(10,20,32,0.48) 48%, rgba(10,20,32,0.18))";
  const imageCache = new Map<string, Promise<void>>();

  function preloadHeroImage(src: string) {
    if (imageCache.has(src)) return imageCache.get(src);

    const promise = new Promise<void>((resolve) => {
      const image = new Image();
      image.onload = () => resolve();
      image.onerror = () => resolve();
      image.src = src;
    });

    imageCache.set(src, promise);
    return promise;
  }

  function hydrateHeroVideo(video: HTMLVideoElement) {
    if (video.dataset.loaded === 'true') return;

    Array.from(video.querySelectorAll('source')).forEach((source) => {
      const lazySource = source as HTMLSourceElement;
      const sourcePath = lazySource.dataset.src;
      if (sourcePath) {
        lazySource.src = sourcePath;
        lazySource.removeAttribute('data-src');
      }
    });

    video.dataset.loaded = 'true';
    video.load();
  }

  function playHeroVideo(video: HTMLVideoElement) {
    hydrateHeroVideo(video);

    videoElements.forEach((element) => {
      element.classList.remove('is-active', 'is-playing');
      if (element !== video) element.pause();
    });

    video.classList.add('is-active');
    video.currentTime = 0;
    video.playbackRate = 0.92;

    const playPromise = video.play();
    if (playPromise) {
      playPromise
        .then(() => video.classList.add('is-playing'))
        .catch(() => video.classList.remove('is-playing'));
    }
  }

  function prepareNextVideo() {
    if (!shouldLoadBackgroundMedia) return;
    if (videoElements.length < 2) return;
    const nextVideo = videoElements[(currentVideoIndex + 1) % videoElements.length];
    if (nextVideo) hydrateHeroVideo(nextVideo);
  }

  videoElements.forEach((video) => {
    video.muted = true;
    video.setAttribute('muted', '');
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');
    video.addEventListener('playing', () => video.classList.add('is-playing'));
    video.addEventListener('pause', () => video.classList.remove('is-playing'));
    video.addEventListener('error', () => video.classList.remove('is-playing'));
  });

  function retryActiveVideo() {
    const activeVideo = videoElements[currentVideoIndex] || videoElements[0];
    if (activeVideo && !activeVideo.classList.contains('is-playing')) {
      playHeroVideo(activeVideo);
    }
  }

  window.addEventListener('touchstart', retryActiveVideo, { once: true, passive: true });
  window.addEventListener('pointerdown', retryActiveVideo, { once: true, passive: true });
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) retryActiveVideo();
  });

  function changeSlide() {
    currentIndex = (currentIndex + 1) % slides.length;
    const next = slides[currentIndex];

    if (titleElement && subtitleElement && heroElement) {
      preloadHeroImage(next.image);
      titleElement.classList.remove('fade-in');
      subtitleElement.classList.remove('fade-in');
      titleElement.classList.add('fade-out');
      subtitleElement.classList.add('fade-out');

      setTimeout(() => {
        heroElement.style.backgroundImage =
          `${heroGradient}, url('${next.image}')`;
        currentVideoIndex = (currentVideoIndex + 1) % videoElements.length;
        const activeVideo = videoElements[currentVideoIndex];
        if (activeVideo) {
          playHeroVideo(activeVideo);
          prepareNextVideo();
        }
        titleElement.innerHTML = next.title;
        subtitleElement.textContent = next.subtitle;
        titleElement.classList.remove('fade-out');
        subtitleElement.classList.remove('fade-out');
        titleElement.classList.add('fade-in');
        subtitleElement.classList.add('fade-in');
      }, 480);
    }
  }

  if (videoElements[0]) {
    playHeroVideo(videoElements[0]);
  }
  setTimeout(() => scheduleIdle(() => {
    prepareNextVideo();
    slides.slice(1, 3).forEach((slide) => preloadHeroImage(slide.image));
  }), 2800);
  if (!carouselTimer) {
    carouselTimer = window.setInterval(changeSlide, 5000);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const lazyVideos = Array.from(document.querySelectorAll('[data-lazy-video]')) as HTMLVideoElement[];
    const hydrateLazyVideo = (video: HTMLVideoElement) => {
      if (video.dataset.loaded === 'true' || !shouldLoadBackgroundMedia) return;
      Array.from(video.querySelectorAll('source')).forEach((source) => {
        const lazySource = source as HTMLSourceElement;
        if (lazySource.dataset.src) {
          lazySource.src = lazySource.dataset.src;
          lazySource.removeAttribute('data-src');
        }
      });
      video.dataset.loaded = 'true';
      video.load();
      video.play().catch(() => undefined);
    };

    if (lazyVideos.length) {
      const videoObserver = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            hydrateLazyVideo(entry.target as HTMLVideoElement);
            currentObserver.unobserve(entry.target);
          }
        });
      }, { root: null, rootMargin: '360px 0px', threshold: 0.01 });

      lazyVideos.forEach((video) => videoObserver.observe(video));
    }

    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
          currentObserver.unobserve(entry.target);
        }
      });
    }, { root: null, rootMargin: "0px", threshold: 0.1 });

    document.querySelectorAll(".reveal").forEach(el => observer.observe(el));
  });
</script>
