---
import Layout from '../layouts/Layout.astro';
import PageStyles from '../components/PageStyles.astro';
---

<Layout
  title="Proyectos | Territorium Capital"
  description="Proyectos e iniciativas de Territorium Capital en gestión patrimonial territorial, capital natural, validación de activos rurales y restauración."
  canonicalPath="/proyectos/"
>
  <PageStyles />

  <main>
    <section class="projects-hero page-first-section reveal">
      <div class="container projects-hero__grid">
        <div>
          <span class="section-kicker">Proyectos</span>
          <h1>Evidencia territorial, metodología y colaboración.</h1>
        </div>
        <div class="projects-hero__copy">
          <p>
            Seleccionamos iniciativas que muestran cómo Territorium convierte
            territorio, datos y criterio patrimonial en decisiones de gestión,
            regeneración e inversión a largo plazo.
          </p>
        </div>
      </div>
    </section>

    <section class="projects-list reveal">
      <div class="container projects-list__grid">
        <a class="project-feature-card" href="/proyectos/regenera/">
          <div class="project-feature-card__media">
            <img src="/imagenes/medidas/nuevas/paisaje-spain.jpg" alt="Paisaje rural con alto valor natural y patrimonial">
          </div>
          <div class="project-feature-card__copy">
            <span>Proyecto destacado</span>
            <h2>REGENERA</h2>
            <p class="project-feature-card__subtitle">Conservar produciendo. Producir regenerando.</p>
            <p>
              Iniciativa de Territorium Capital y GestLand para gestionar y
              regenerar grandes activos rurales con datos, criterio patrimonial
              y ejecución sobre el terreno.
            </p>
            <strong>Ver proyecto</strong>
          </div>
        </a>

        <a class="project-feature-card project-feature-card--reverse" href="/proyectos/resiliencia-agricola/">
          <div class="project-feature-card__media">
            <img src="/imagenes/medidas/nuevas/riesgo-climatico-sequia.jpg" alt="Territorio agrícola afectado por estrés hídrico">
          </div>
          <div class="project-feature-card__copy">
            <span>Línea de trabajo</span>
            <h2>Resiliencia agrícola</h2>
            <p class="project-feature-card__subtitle">Infraestructura natural frente al clima</p>
            <p>
              Medimos cómo suelo, agua, cubierta vegetal, biodiversidad y
              conectividad pueden ayudar a reducir vulnerabilidad agrícola ante
              sequías, calor, lluvias intensas y otros eventos climáticos.
            </p>
            <strong>Ver proyecto</strong>
          </div>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
          currentObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll(".reveal").forEach(el => observer.observe(el));
  });
</script>
