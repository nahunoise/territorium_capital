---
import Layout from '../layouts/Layout.astro';
import PageStyles from '../components/PageStyles.astro';

const projects = [
  {
    href: '/proyectos/living-lab-restauracion-ecologica/',
    image: '/imagenes/medidas/nuevas/biodiversidad-ciervo.jpg',
    alt: 'Fauna salvaje como indicador de biodiversidad y condición del ecosistema',
    eyebrow: 'Proyecto destacado',
    title: 'Living Lab de restauración ecológica',
    subtitle: 'Infraestructura de evidencia para condición del ecosistema',
    body: 'Un laboratorio territorial para co-diseñar, ensayar y medir intervenciones de restauración con teledetección, modelización ecológica, cámaras trampa, ecoacústica y seguimiento periódico.',
  },
  {
    href: '/proyectos/sistema-alerta-temprana-arbolado/',
    image: '/imagenes/medidas/nuevas/conectividad-bosque.jpg',
    alt: 'Arbolado monitorizado como infraestructura natural y activo de gestión preventiva',
    eyebrow: 'Línea de trabajo',
    title: 'Sistema de alerta temprana del arbolado',
    subtitle: 'Sensores, datos y gestión preventiva',
    body: 'Medición continua para detectar anomalías, priorizar inspecciones y activar actuaciones antes de que el riesgo del arbolado se convierta en incidente.',
  },
  {
    href: '/proyectos/resiliencia-agricola/',
    image: '/imagenes/medidas/nuevas/riesgo-climatico-sequia.jpg',
    alt: 'Territorio agrícola afectado por estrés hídrico',
    eyebrow: 'Línea de trabajo',
    title: 'Resiliencia agrícola',
    subtitle: 'Infraestructura natural frente al clima',
    body: 'Medimos cómo suelo, agua, cubierta vegetal, biodiversidad y conectividad pueden ayudar a reducir vulnerabilidad agrícola ante sequías, calor, lluvias intensas y otros eventos climáticos.',
  },
  {
    href: '/proyectos/viviendas-impacto-positivo/',
    image: '/imagenes/territorio-urbano-analisis.jpg',
    alt: 'Análisis de infraestructura verde aplicado a un entorno urbano',
    eyebrow: 'Línea de trabajo',
    title: 'Viviendas de impacto positivo en naturaleza',
    subtitle: 'BNG voluntario, reducción y restauración',
    body: 'Aplicamos una lógica inspirada en Biodiversity Net Gain para medir línea base, reducir impactos, evitar daños y generar mejora positiva en naturaleza con actuaciones in situ y restauración ex situ.',
  },
  {
    href: '/proyectos/regenera/',
    image: '/imagenes/regenera-dehesa-camino.jpg',
    alt: 'Dehesa mediterránea gestionada como activo rural de largo plazo',
    eyebrow: 'Proyecto destacado',
    title: 'REGENERA',
    subtitle: 'Conservar produciendo. Producir regenerando.',
    body: 'Iniciativa de Territorium Capital y GestLand para gestionar y regenerar grandes activos rurales con datos, criterio patrimonial y ejecución sobre el terreno.',
  },
];
---

<Layout
  title="Proyectos | Territorium Capital"
  description="Proyectos e iniciativas de Territorium Capital en gestión patrimonial territorial, capital natural, validación de activos rurales y restauración."
  canonicalPath="/proyectos/"
  alternateEnPath="/en/projects/"
>
  <PageStyles />

  <main>
    <section class="projects-hero page-first-section reveal">
      <div class="container projects-hero__grid">
        <div>
          <span class="section-kicker">Proyectos</span>
          <h1>Evidencia territorial, metodología y colaboración.</h1>
        </div>
        <div class="projects-hero__copy">
          <p>
            Seleccionamos iniciativas que muestran cómo Territorium convierte
            territorio, datos y criterio patrimonial en decisiones de gestión,
            regeneración e inversión a largo plazo.
          </p>
        </div>
      </div>
    </section>

    <section class="projects-carousel-section" aria-label="Carrusel de proyectos">
      <div class="projects-carousel-shell" data-projects-carousel>
        <div class="projects-carousel__top">
          <div>
            <span class="section-kicker">Trabajos en curso</span>
            <h2>Proyectos que convierten el capital natural en decisiones.</h2>
          </div>
          <div class="projects-carousel__controls" aria-label="Controles del carrusel">
            <button type="button" data-project-prev aria-label="Proyecto anterior">←</button>
            <button type="button" data-project-next aria-label="Proyecto siguiente">→</button>
          </div>
        </div>

        <div class="projects-carousel" data-projects-track tabindex="0">
          {projects.map((project, index) => (
            <a class="project-slide" href={project.href} data-project-slide>
              <img src={project.image} alt={project.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async">
              <div class="project-slide__shade"></div>
              <div class="project-slide__copy">
                <span>{project.eyebrow}</span>
                <small>{String(index + 1).padStart(2, '0')}</small>
                <h2>{project.title}</h2>
                <p class="project-slide__subtitle">{project.subtitle}</p>
                <p>{project.body}</p>
                <strong>Ver proyecto</strong>
              </div>
            </a>
          ))}
          <a class="project-slide project-slide--clone" href={projects[0].href} data-project-slide data-project-clone aria-label={`${projects[0].title}, continuación del carrusel`}>
            <img src={projects[0].image} alt="" loading="lazy" decoding="async">
            <div class="project-slide__shade"></div>
            <div class="project-slide__copy">
              <span>{projects[0].eyebrow}</span>
              <small>01</small>
              <h2>{projects[0].title}</h2>
              <p class="project-slide__subtitle">{projects[0].subtitle}</p>
              <p>{projects[0].body}</p>
              <strong>Ver proyecto</strong>
            </div>
          </a>
        </div>

        <div class="projects-carousel__dots" aria-label="Seleccionar proyecto">
          {projects.map((project, index) => (
            <button
              type="button"
              data-project-dot={index}
              aria-label={`Ir a ${project.title}`}
              class:list={[index === 0 && 'is-active']}
            ></button>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
          currentObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll(".reveal").forEach(el => observer.observe(el));

    const carousel = document.querySelector("[data-projects-carousel]");
    const track = carousel?.querySelector("[data-projects-track]") as HTMLElement | null;
    const slides = Array.from(carousel?.querySelectorAll("[data-project-slide]") ?? []) as HTMLElement[];
    const dots = Array.from(carousel?.querySelectorAll("[data-project-dot]") ?? []) as HTMLButtonElement[];
    const prev = carousel?.querySelector("[data-project-prev]") as HTMLButtonElement | null;
    const next = carousel?.querySelector("[data-project-next]") as HTMLButtonElement | null;

    if (!track || slides.length === 0) return;

    let activeIndex = 0;
    let autoTimer: number | undefined;
    let resumeTimer: number | undefined;
    let isPointerDown = false;
    let startX = 0;
    let startScroll = 0;
    const realSlideCount = dots.length || slides.length;

    const getSlideLeft = (index: number) => slides[index]?.offsetLeft ?? 0;
    const normalizeIndex = (index: number) => ((index % realSlideCount) + realSlideCount) % realSlideCount;

    const setActive = (index: number) => {
      activeIndex = normalizeIndex(index);
      dots.forEach((dot, dotIndex) => dot.classList.toggle("is-active", dotIndex === activeIndex));
    };

    const scrollToSlide = (index: number) => {
      const nextIndex = index === realSlideCount ? realSlideCount : normalizeIndex(index);
      track.scrollTo({ left: getSlideLeft(nextIndex), behavior: "smooth" });
      setActive(nextIndex);
      if (nextIndex === realSlideCount) {
        window.setTimeout(() => {
          track.scrollTo({ left: getSlideLeft(0), behavior: "auto" });
        }, 620);
      }
    };

    const syncActiveFromScroll = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      const closest = slides.reduce((bestIndex, slide, index) => {
        const currentDistance = Math.abs(slide.offsetLeft + slide.clientWidth / 2 - center);
        const bestSlide = slides[bestIndex];
        const bestDistance = Math.abs(bestSlide.offsetLeft + bestSlide.clientWidth / 2 - center);
        return currentDistance < bestDistance ? index : bestIndex;
      }, 0);
      setActive(closest);
      if (closest === realSlideCount && Math.abs(track.scrollLeft - getSlideLeft(closest)) < 8) {
        window.requestAnimationFrame(() => track.scrollTo({ left: getSlideLeft(0), behavior: "auto" }));
      }
    };

    const stopAuto = () => {
      if (autoTimer) window.clearInterval(autoTimer);
      autoTimer = undefined;
    };

    const startAuto = () => {
      stopAuto();
      autoTimer = window.setInterval(() => scrollToSlide(activeIndex + 1), 4200);
    };

    const pauseThenResume = () => {
      stopAuto();
      if (resumeTimer) window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(startAuto, 5500);
    };

    prev?.addEventListener("click", () => {
      scrollToSlide(activeIndex - 1);
      pauseThenResume();
    });

    next?.addEventListener("click", () => {
      scrollToSlide(activeIndex + 1);
      pauseThenResume();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        scrollToSlide(index);
        pauseThenResume();
      });
    });

    track.addEventListener("scroll", () => window.requestAnimationFrame(syncActiveFromScroll), { passive: true });
    track.addEventListener("mouseenter", stopAuto);
    track.addEventListener("mouseleave", startAuto);
    track.addEventListener("focusin", stopAuto);
    track.addEventListener("focusout", startAuto);
    track.addEventListener("pointerdown", (event) => {
      isPointerDown = true;
      startX = event.clientX;
      startScroll = track.scrollLeft;
      track.classList.add("is-dragging");
      pauseThenResume();
    });
    track.addEventListener("pointermove", (event) => {
      if (!isPointerDown) return;
      track.scrollLeft = startScroll - (event.clientX - startX);
    });
    window.addEventListener("pointerup", () => {
      isPointerDown = false;
      track.classList.remove("is-dragging");
    });

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      startAuto();
    }
  });
</script>
