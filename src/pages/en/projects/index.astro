---
import Layout from '../../../layouts/Layout.astro';
import PageStyles from '../../../components/PageStyles.astro';

const projects = [
  {
    href: '/en/projects/ecological-restoration-living-lab/',
    image: '/imagenes/living-lab-ndvi-estacional.png',
    alt: 'Seasonal NDVI maps used to measure ecosystem condition',
    eyebrow: 'Featured project',
    title: 'Ecological restoration Living Lab',
    subtitle: 'Evidence infrastructure for ecosystem condition',
    body: 'A territorial lab to co-design, test and measure restoration interventions with remote sensing, ecological modelling, camera trapping, ecoacoustics and periodic monitoring.',
  },
  {
    href: '/proyectos/sistema-alerta-temprana-arbolado/',
    image: '/imagenes/medidas/nuevas/conectividad-bosque.jpg',
    alt: 'Trees monitored as natural infrastructure and preventive management assets',
    eyebrow: 'Workstream',
    title: 'Early warning tree system',
    subtitle: 'Sensors, data and preventive management',
    body: 'Continuous monitoring to detect anomalies, prioritise inspections and activate measures before tree risk becomes an incident.',
  },
  {
    href: '/proyectos/resiliencia-agricola/',
    image: '/imagenes/medidas/nuevas/riesgo-climatico-sequia.jpg',
    alt: 'Agricultural land affected by water stress',
    eyebrow: 'Workstream',
    title: 'Agricultural resilience',
    subtitle: 'Natural infrastructure against climate risk',
    body: 'We measure how soil, water, vegetation cover, biodiversity and ecological connectivity can help reduce agricultural vulnerability to drought, heat and intense rainfall.',
  },
  {
    href: '/proyectos/viviendas-impacto-positivo/',
    image: '/imagenes/territorio-urbano-analisis.jpg',
    alt: 'Green infrastructure analysis applied to an urban environment',
    eyebrow: 'Workstream',
    title: 'Nature-positive housing',
    subtitle: 'Voluntary BNG, reduction and restoration',
    body: 'We apply a logic inspired by Biodiversity Net Gain to measure baselines, reduce impacts, avoid damage and generate positive nature outcomes through on-site and off-site restoration.',
  },
  {
    href: '/proyectos/regenera/',
    image: '/imagenes/regenera-dehesa-camino.jpg',
    alt: 'Mediterranean dehesa managed as a long-term rural asset',
    eyebrow: 'Featured project',
    title: 'REGENERA',
    subtitle: 'Conserving by producing. Producing by regenerating.',
    body: 'A Territorium Capital and GestLand initiative to manage and regenerate large rural assets with data, patrimonial criteria and execution on the ground.',
  },
];
---

<Layout
  title="Projects | Territorium Capital"
  description="Territorium Capital projects in territorial asset management, natural capital, rural asset validation, resilience and restoration."
  canonicalPath="/en/projects/"
  alternateEsPath="/proyectos/"
  lang="en"
>
  <PageStyles />

  <main>
    <section class="projects-hero page-first-section reveal">
      <div class="container projects-hero__grid">
        <div>
          <span class="section-kicker">Projects</span>
          <h1>Territorial evidence, methodology and collaboration.</h1>
        </div>
        <div class="projects-hero__copy">
          <p>
            We select initiatives that show how Territorium turns land, data
            and patrimonial criteria into decisions for management,
            regeneration and long-term investment.
          </p>
        </div>
      </div>
    </section>

    <section class="projects-carousel-section" aria-label="Project carousel">
      <div class="projects-carousel-shell" data-projects-carousel>
        <div class="projects-carousel__top">
          <div>
            <span class="section-kicker">Work in progress</span>
            <h2>Projects that turn natural capital into decisions.</h2>
          </div>
          <div class="projects-carousel__controls" aria-label="Carousel controls">
            <button type="button" data-project-prev aria-label="Previous project">←</button>
            <button type="button" data-project-next aria-label="Next project">→</button>
          </div>
        </div>

        <div class="projects-carousel" data-projects-track tabindex="0">
          {projects.map((project, index) => (
            <a class="project-slide" href={project.href} data-project-slide>
              <img src={project.image} alt={project.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async">
              <div class="project-slide__shade"></div>
              <div class="project-slide__copy">
                <span>{project.eyebrow}</span>
                <small>{String(index + 1).padStart(2, '0')}</small>
                <h2>{project.title}</h2>
                <p class="project-slide__subtitle">{project.subtitle}</p>
                <p>{project.body}</p>
                <strong>View project</strong>
              </div>
            </a>
          ))}
        </div>

        <div class="projects-carousel__dots" aria-label="Select project">
          {projects.map((project, index) => (
            <button
              type="button"
              data-project-dot={index}
              aria-label={`Go to ${project.title}`}
              class:list={[index === 0 && 'is-active']}
            ></button>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
          currentObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll(".reveal").forEach(el => observer.observe(el));

    const carousel = document.querySelector("[data-projects-carousel]");
    const track = carousel?.querySelector("[data-projects-track]") as HTMLElement | null;
    const slides = Array.from(carousel?.querySelectorAll("[data-project-slide]") ?? []) as HTMLElement[];
    const dots = Array.from(carousel?.querySelectorAll("[data-project-dot]") ?? []) as HTMLButtonElement[];
    const prev = carousel?.querySelector("[data-project-prev]") as HTMLButtonElement | null;
    const next = carousel?.querySelector("[data-project-next]") as HTMLButtonElement | null;

    if (!track || slides.length === 0) return;

    let activeIndex = 0;
    let autoTimer: number | undefined;
    let resumeTimer: number | undefined;
    let isPointerDown = false;
    let startX = 0;
    let startScroll = 0;

    const getSlideLeft = (index: number) => slides[index]?.offsetLeft ?? 0;

    const setActive = (index: number) => {
      activeIndex = Math.max(0, Math.min(slides.length - 1, index));
      dots.forEach((dot, dotIndex) => dot.classList.toggle("is-active", dotIndex === activeIndex));
    };

    const scrollToSlide = (index: number) => {
      const nextIndex = (index + slides.length) % slides.length;
      track.scrollTo({ left: getSlideLeft(nextIndex), behavior: "smooth" });
      setActive(nextIndex);
    };

    const syncActiveFromScroll = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      const closest = slides.reduce((bestIndex, slide, index) => {
        const currentDistance = Math.abs(slide.offsetLeft + slide.clientWidth / 2 - center);
        const bestSlide = slides[bestIndex];
        const bestDistance = Math.abs(bestSlide.offsetLeft + bestSlide.clientWidth / 2 - center);
        return currentDistance < bestDistance ? index : bestIndex;
      }, 0);
      setActive(closest);
    };

    const stopAuto = () => {
      if (autoTimer) window.clearInterval(autoTimer);
      autoTimer = undefined;
    };

    const startAuto = () => {
      stopAuto();
      autoTimer = window.setInterval(() => scrollToSlide(activeIndex + 1), 4200);
    };

    const pauseThenResume = () => {
      stopAuto();
      if (resumeTimer) window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(startAuto, 5500);
    };

    prev?.addEventListener("click", () => {
      scrollToSlide(activeIndex - 1);
      pauseThenResume();
    });

    next?.addEventListener("click", () => {
      scrollToSlide(activeIndex + 1);
      pauseThenResume();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        scrollToSlide(index);
        pauseThenResume();
      });
    });

    track.addEventListener("scroll", () => window.requestAnimationFrame(syncActiveFromScroll), { passive: true });
    track.addEventListener("mouseenter", stopAuto);
    track.addEventListener("mouseleave", startAuto);
    track.addEventListener("focusin", stopAuto);
    track.addEventListener("focusout", startAuto);
    track.addEventListener("pointerdown", (event) => {
      isPointerDown = true;
      startX = event.clientX;
      startScroll = track.scrollLeft;
      track.classList.add("is-dragging");
      pauseThenResume();
    });
    track.addEventListener("pointermove", (event) => {
      if (!isPointerDown) return;
      track.scrollLeft = startScroll - (event.clientX - startX);
    });
    window.addEventListener("pointerup", () => {
      isPointerDown = false;
      track.classList.remove("is-dragging");
    });

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      startAuto();
    }
  });
</script>
